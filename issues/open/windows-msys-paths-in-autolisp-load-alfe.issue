ERRFILE="/c/Users/PPBN02261/works/sncf-reseau/src/schms/tests/.autolisp-workdir/unitaire/test-unitaire.err" \
STATUSFILE="/c/Users/PPBN02261/works/sncf-reseau/src/schms/tests/.autolisp-workdir/unitaire/test-unitaire.status" \
            clautolisp -norc --host cador --dialect bricscad-v26 -Esource WINDOWS-1252 --on-error debug \
            -x '(setq *AUTOLISP_OUTFILE* "/c/Users/PPBN02261/works/sncf-reseau/src/schms/tests/.autolisp-workdir/unitaire/test-unitaire.out")' \
