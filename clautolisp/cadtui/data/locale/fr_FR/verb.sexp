;;;; cadtui fr_FR — interaction-language VERB dictionary.
;;;; Category :verb. An alist (international-token . fr_FR-token). Canonical
;;;; tokens are English; a leading _ on input always forces the international
;;;; form. Data, not code (spec §Localisation) — WE author this one (the
;;;; interaction language), unlike the CAD command.sexp which is probe-measured.
(("activate"         . "activer")
 ("dump"             . "lister")
 ("page"             . "page")
 ("next"             . "suivant")
 ("previous"         . "precedent")
 ("help"             . "aide")
 ("select"           . "selectionner")
 ("add-selection"    . "ajouter-selection")
 ("remove-selection" . "retirer-selection")
 ("input"            . "saisir")
 ("close"            . "fermer")
 ("zoom"             . "zoom")
 ("pan"              . "panoramique")
 ("key"              . "touche")
 ("click"            . "clic")
 ("dclick"           . "double-clic")
 ("right-click"      . "clic-droit")
 ("drag"             . "glisser")
 ("cancel-command"   . "annuler-commande")
 ("locale"           . "locale"))
