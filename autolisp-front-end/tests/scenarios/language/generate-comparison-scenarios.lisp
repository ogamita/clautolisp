;;;; generate-comparison-scenarios.lisp
;;;;
;;;; Regenerate the conformance scenarios for the comparison-operators
;;;; PROBE (= /= < <= > >=) from the canonical .lsp, so the embedded copies
;;;; stay byte-identical. The probe emits OBSERVE lines (autolisp-spec ch.25
;;;; probe model); each scenario carries the per-target
;;;; :expected-observations measured on the vendors
;;;; (issues/closed/comparison-operators-vendor-semantics.issue). Run from
;;;; this directory:
;;;;
;;;;   sbcl --script generate-comparison-scenarios.lisp
;;;;
;;;; It (re)writes comparison-operators{,-bricscad,-autocad}.sexp.

(defun slurp (path)
  ;; Character by character: FILE-LENGTH counts octets, which over-counts
  ;; the multibyte characters of a UTF-8 file.
  (with-open-file (in path :direction :input :external-format :utf-8)
    (with-output-to-string (out)
      (loop for ch = (read-char in nil nil)
            while ch do (write-char ch out)))))

