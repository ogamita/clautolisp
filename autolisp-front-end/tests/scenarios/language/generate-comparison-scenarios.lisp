(defparameter *bricscad-divergences*
  '(("ge.sym-nil" "error")
    ("gt.nil-int-str" "error")
    ("ge.nil-int-str" "error"))
  "(NAME TOKEN) where BricsCAD V25 (Windows) and V26 (macOS) differ from
the normative token -- a KNOWN-DIVERGENCE for the BricsCAD scenario.")

(defun bricscad-observations ()
  (mapcar (lambda (row)
            (let ((deviant (assoc (first row) *bricscad-divergences* :test #'string=)))
              (if deviant
                  (list (first row) (second deviant) (second row))
                  row)))
          *normative*))

(defun write-scenario (sexp-name &key name description classification argv
                                      lsp-file lsp-text observations covers)
  (with-open-file (out sexp-name :direction :output :if-exists :supersede
                                 :if-does-not-exist :create :external-format :utf-8)
    (format out "(:name ~S~%" name)
    (format out " :description ~S~%" description)
    (format out " :classification :~(~A~)~%" (symbol-name classification))
    (format out " :argv ~S~%" argv)
    (format out " :setup-files ((~S " lsp-file)
    (prin1 lsp-text out)
    (format out "))~%")
    (format out " :expected-exit 0~%")
    (format out " :expected-observations (~%")
    (dolist (o observations)
      (format out "   ~S~%" o))
    (format out "  )~%")
    (format out " :covers-options ~S)~%" covers)))

(let* ((lsp "comparison-operators-probe.lsp")
       (text (slurp lsp)))
  (write-scenario "comparison-operators.sexp"
    :name "comparison-operators-clautolisp"
    :description "The comparison-operators probe (comparison-operators-probe.lsp): 40 argument cases through = /= < <= > >=, 240 observations, run under the clautolisp backend. clautolisp must exhibit the normative tokens, i.e. AutoCAD 2022's answers: the vendors agree on 237 observations and AutoCAD is adopted for the other three (autolisp-spec ch.5, The Comparison Operators)."
    :classification :clautolisp-only
    :argv (list "--clautolisp" "-l" lsp)
    :lsp-file lsp :lsp-text text :observations *normative*
    :covers (list "--clautolisp" "-l"))
  (write-scenario "comparison-operators-bricscad.sexp"
    :name "comparison-operators-bricscad"
    :description "The SAME comparison-operators probe, run UNCHANGED on BricsCAD via alfe. Classified bricscad-only: skipped unless BricsCAD is detected and $ALFE_VENDOR_CONFORMANCE is set. BricsCAD V25/V26 were measured identical to AutoCAD except three rows, recorded as KNOWN-DIVERGENCE: (>= 'a nil), (> nil 1 \"a\") and (>= nil 1 \"a\") signal on BricsCAD."
    :classification :bricscad-only
    :argv (list "--bricscad" "-l" lsp)
    :lsp-file lsp :lsp-text text :observations (bricscad-observations)
    :covers (list "--bricscad" "-l"))
  (write-scenario "comparison-operators-autocad.sexp"
    :name "comparison-operators-autocad"
    :description "The SAME comparison-operators probe, run UNCHANGED on AutoCAD via alfe. Classified autocad-only: skipped unless AutoCAD is detected and $ALFE_VENDOR_CONFORMANCE is set. AutoCAD 2022 is the normative vendor for every observation."
    :classification :autocad-only
    :argv (list "--autocad" "-l" lsp)
    :lsp-file lsp :lsp-text text :observations *normative*
    :covers (list "--autocad" "-l")))
