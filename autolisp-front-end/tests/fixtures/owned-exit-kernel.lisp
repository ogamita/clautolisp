;;;; Real Windows process handles; only signed PowerShell child processes, no CAD.
(in-package #:autolisp-front-end.tests)
(defun run-owned-exit-kernel-fixtures (base)
 (let ((checks 0))
 (dolist (code '(0 17 -1073740940))
  (let ((dir (merge-pathnames (format nil "case-~D/" (abs code)) base)))
   (ensure-directories-exist dir)
   (with-open-file (out (merge-pathnames "owned-cad-process.ps1" dir) :direction :output :if-exists :supersede)
    (write-string alfe.backend.cad-common::*owned-cad-process-script* out))
   (uiop:run-program (list "powershell.exe" "-NoProfile" "-NonInteractive" "-ExecutionPolicy" "Bypass" "-File"
                           (uiop:native-namestring (asdf:system-relative-pathname "autolisp-front-end" "tests/fixtures/owned-exit-spawn.ps1"))
                           "-Directory" (uiop:native-namestring dir) "-Code" (princ-to-string code)) :output t :error-output t)
   (multiple-value-bind (verify release) (alfe.backend.cad-common::open-owned-cad-native-exit-proof dir)
    (assert verify)
    (unwind-protect
      (if (zerop code)
       (assert (funcall verify 20))
       (let ((rejected nil))
        (handler-case (funcall verify 20)
          (alfe.error:backend-protocol-error () (setf rejected t)))
        (assert rejected)))
     (funcall release)))
   (let ((native (with-open-file (in (merge-pathnames "native-exit-code.txt" dir)) (read in))))
    (assert (= native (mod code (expt 2 32))))
    (assert (if (zerop code)
                (probe-file (merge-pathnames "native-exit-normal.txt" dir))
                (not (probe-file (merge-pathnames "native-exit-normal.txt" dir)))))
    (incf checks)
    (format t "PASS native process exit ~D~%" native))))
 (let ((dir (merge-pathnames "attached/" base)))
  (ensure-directories-exist dir)
  (with-open-file (out (merge-pathnames "com-flags.txt" dir) :direction :output :if-exists :supersede)
   (format out "CREATED=0~C~%ATTACHED=1~C~%" #\Return #\Return))
  (multiple-value-bind (verify release) (alfe.backend.cad-common::open-owned-cad-native-exit-proof dir)
   (assert (and (null verify) (null release))) (incf checks)))
 (format t "PASS ~D native Windows process fixtures, no CAD launched~%" checks)
 checks))
