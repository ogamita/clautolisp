;;;; probes/sources/probe-sysvar-flags.lsp
;;;;
;;;; windows-runner-sunset-probe-campaign, batch B5 (AC-crit). The sysvar
;;;; read-only flags, defaults and integer ranges the spec carries from the
;;;; vendors' documentation and never measured -- AutoCAD's answer is lost
;;;; with the Windows runner:
;;;;
;;;;   - read-only: the variables whose read-only flag the vendors document
;;;;     differently (SECURELOAD -- security-critical, it gates load/arxload --
;;;;     BACKZ, FRONTZ, TRUSTEDPATHS, LENSLENGTH, PUCSBASE, LEGACYCODESEARCH).
;;;;     Each is SET TO ITS OWN VALUE: a read-only one refuses, and nothing
;;;;     changes either way. Record: (RESULT VALUE-AFTER ERRNO).
;;;;   - defaults: GETVAR of the variables with a documented default
;;;;     divergence, on the fresh drawing the batch run starts on.
;;;;   - ranges: each integer variable with a documented range, saved in the
;;;;     drawing or the session (never a registry/preference one: a run dying
;;;;     mid-sweep must not leave the runner changed), tried just below, at and
;;;;     just above each bound; each value is restored at once. This is the
;;;;     data setvar-validation-as-measured point 1 waits on.
;;;;
;;;; GENERATED from autolisp-spec/documentation/system-variables-inventory.sexp
;;;; (vendor :both; read-only: a divergence naming read-only; defaults: a
;;;; divergence naming the default; ranges: :type :integer, a :range, not
;;;; read-only, :saved-in :drawing or :session, CVPORT excluded -- it switches
;;;; the active viewport). Re-generate rather than hand-edit the lists.
;;;;
;;;; Portability (probes/README.org): each case is a STRING (eval (read ...))'d;
;;;; the case name is the exact expression.

(defun cad-probe--b5 (case-text)
  (cad-probe-capture "sysvar-flags" case-text
    (function (lambda () (vl-prin1-to-string (eval (read case-text)))))))

(defun cad-probe--b5sv (cad-probe--b5-name cad-probe--b5-value / old r after errno)
  ;; Try (setvar NAME VALUE) under VL-CATCH-ALL-APPLY, read it back and the
  ;; ERRNO, then RESTORE the saved value: a probe leaves the CAD as it found it.
  (setq old (getvar cad-probe--b5-name))
  (vl-catch-all-apply 'setvar (list "ERRNO" 0))
  (setq r (vl-catch-all-apply 'setvar (list cad-probe--b5-name cad-probe--b5-value)))
  (setq after (getvar cad-probe--b5-name))
  (setq errno (getvar "ERRNO"))
  (if old (vl-catch-all-apply 'setvar (list cad-probe--b5-name old)))
  (list (if (vl-catch-all-error-p r) (list 'error (vl-catch-all-error-message r)) r)
        after errno))

(defun cad-probe--b5self (cad-probe--b5-name2)
  ;; Set NAME to its own current value: refused only if read-only.
  (cad-probe--b5sv cad-probe--b5-name2 (getvar cad-probe--b5-name2)))

