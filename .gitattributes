# Binary assets must never be line-ending-converted (a CRLF pass would corrupt
# the DWG on a Windows checkout -- the vendor probes open this file).
*.dwg binary
*.dwt binary
*.dws binary

# Common Lisp uses `~` immediately before a newline as a FORMAT control
# continuation. CRLF checkout inserts a #\Return after `~`, turning it into
# an invalid directive, so source files must remain LF on Windows.
*.lisp text eol=lf
